// Standalone Pharmacy Management Software — Prisma schema.
// Separate project, separate database from hms-backend (PROJECT_MASTER_SPEC.md
// §1: "a separate project"). Never a direct FK into HMS's schema — the future
// HMS<->Pharmacy integration (pharmacy.md §7/§15) is an API-level hand-off,
// so `PharmacyInvoice.externalAdmissionRef` below is a plain string, not a
// relation. See pharmacy.md for the full functional spec this schema follows.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════

/// pharmacy.md §2/§13 — collapsed from the older 3-portal design (D07-D10):
/// SUPER_ADMIN and ADMIN now share one Management Portal (permission-based
/// difference only); SALES_DISPENSING keeps its own separate Sales Portal.
enum PortalRole {
  SUPER_ADMIN
  ADMIN
  SALES_DISPENSING
}

enum PortalUserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// pharmacy.md §6/§7 — a sale is either a walk-in POS sale or fulfillment
/// of an HMS-originated medicine request.
enum SaleChannel {
  RETAIL
  HMS_LINKED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// pharmacy.md §8 — only meaningful for SaleChannel.HMS_LINKED invoices;
/// null for RETAIL. Drives what HMS is told back (§15).
enum ClearanceStatus {
  OUTSTANDING
  CLEARED
  APPROVED_CREDIT
}

enum CollectionOwner {
  PHARMACY_RETAIL
  HMS_FRONT_DESK
}

enum InternalSettlementStatus {
  NOT_DUE
  PENDING
  REQUESTED
  PARTIALLY_RELEASED
  SETTLED
  REJECTED
}

/// pharmacy.md §7.1 steps 3-4 — the Accept/Partial/Reject decision on an
/// inbound HMS medicine request, before it becomes a PharmacyInvoice.
enum MedicineRequestStatus {
  REQUESTED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  DISPENSED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

/// pharmacy.md §9.1 — every Stock Movement Center tab, all wired from day one
/// (unlike hms-backend's MedicineStockLedger, which only ever posts RECEIPT/
/// SALE/DISPENSE today — pharmacy.md §19.3).
enum StockMovementType {
  PURCHASE_IN
  POS_SALE_OUT
  HMS_DISPENSE_OUT
  SALES_RETURN_IN
  PURCHASE_RETURN_OUT
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  OPENING_STOCK
}

enum AdjustmentType {
  DAMAGE
  EXPIRY
  COUNT_CORRECTION
  LOSS
  SURPLUS
  QUARANTINE
}

/// pharmacy.md §10.3 vendor ledger formula:
/// Opening + Purchases - Payments - Returns/Credits +/- Adjustments = Closing.
enum VendorLedgerEntryType {
  PURCHASE_CREDIT
  PAYMENT
  RETURN_CREDIT
  ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  POSTED
}

/// Purchase Order = what we want to order (a procurement reminder sent to a
/// vendor, zero stock/cost/ledger impact). Distinct from Purchase (= what we
/// actually received, the Stock In / GRN record above). OPEN is editable/
/// cancellable; CONVERTED once "Receive / Convert to Stock In" is used to
/// pre-fill a real Purchase (the PO itself still never posts stock).
enum PurchaseOrderStatus {
  OPEN
  CONVERTED
  CANCELLED
}

/// purchase-costing-plan — how a PurchaseLine's discount was entered.
enum DiscountType {
  PERCENTAGE
  FLAT
}

/// pharmacy.md §11 petty-cash flow direction, from each user's own point of view.
enum CashDirection {
  IN
  OUT
}

enum CashCategory {
  PETTY_CASH_ISSUED
  PETTY_CASH_RECEIVED
  POS_COLLECTION
  HMS_COLLECTION
  REFUND
  VENDOR_PAYMENT
  EXPENSE_PAYMENT
  SETTLEMENT_HANDOVER
  ADJUSTMENT
}

enum SettlementStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════
// Identity (pharmacy.md §13 — Super Admin -> Admin only, Admin -> Sales only)
// ═══════════════════════════════════════════════════════════════════════

model PortalUser {
  id                String           @id @default(uuid())
  username          String           @unique
  email             String?          @unique
  fullName          String           @map("full_name")
  phone             String?
  passwordHash      String           @map("password_hash")
  role              PortalRole
  status            PortalUserStatus @default(ACTIVE)
  /// true only for the bootstrap SUPER_ADMIN — mirrors hms-backend's
  /// isProtected pattern (pharmacy.md §2.1 "Protected Super Admin").
  isProtected       Boolean          @default(false) @map("is_protected")
  mustResetPassword Boolean          @default(true) @map("must_reset_password")
  lastLoginAt       DateTime?        @map("last_login_at")

  createdById   String?      @map("created_by")
  createdByUser PortalUser?  @relation("PortalUserCreatedBy", fields: [createdById], references: [id])
  createdUsers  PortalUser[] @relation("PortalUserCreatedBy")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  refreshTokens        RefreshToken[]
  createdMedicines     MedicineMaster[]    @relation("MedicineCreatedBy")
  createdMedicineCategories MedicineCategory[] @relation("MedicineCategoryCreatedBy")
  createdBatches       MedicineBatch[]     @relation("BatchCreatedBy")
  stockMovements       StockLedgerEntry[]  @relation("StockMovementActor")
  createdVendors       Vendor[]            @relation("VendorCreatedBy")
  vendorLedgerEntries  VendorLedgerEntry[] @relation("VendorLedgerActor")
  createdPurchases     Purchase[]          @relation("PurchaseCreatedBy")
  createdPurchaseOrders PurchaseOrder[]    @relation("PurchaseOrderCreatedBy")
  dispensedInvoices    PharmacyInvoice[]   @relation("InvoiceDispensedBy")
  collectedPayments    PharmacyPayment[]   @relation("PaymentCollectedBy")
  handledRequests      MedicineRequest[]   @relation("RequestHandledBy")
  approvedRequests     MedicineRequest[]   @relation("RequestApprovedBy")
  enteredExpenses      Expense[]           @relation("ExpenseEnteredBy")
  approvedExpenses     Expense[]           @relation("ExpenseApprovedBy")
  cashEntriesOwned     CashLedgerEntry[]   @relation("CashEntryOwner")
  cashEntriesIssued    CashLedgerEntry[]   @relation("CashEntryIssuedBy")
  settlementsSubmitted AccountSettlement[] @relation("SettlementSubmittedBy")
  settlementsReviewed  AccountSettlement[] @relation("SettlementReviewedBy")
  requestedReceivableSettlements HmsReceivableSettlement[] @relation("ReceivableSettlementRequestedBy")

  @@map("portal_users")
}

model RefreshToken {
  id           String     @id @default(uuid())
  portalUserId String     @map("portal_user_id")
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id])
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════════════
// Medicines, Batches, Stock (pharmacy.md §9)
// ═══════════════════════════════════════════════════════════════════════

model MedicineMaster {
  id           String   @id @default(uuid())
  code         String   @unique
  barcode      String?  @unique
  name         String
  genericName  String?  @map("generic_name")
  /// e.g. "500mg" — kept separate from `name` so the name field stays clean (Add-Medicine-form fix).
  strength     String?
  /// Clinical form e.g. Tablet/Capsule/Syrup/Injection — independent of baseUnit (inventory counting unit).
  dosageForm   String?  @map("dosage_form")
  /// Database-driven category master (Settings -> Medicine Categories). Nullable — a medicine may have no category.
  categoryId   String?  @map("category_id")
  category     MedicineCategory? @relation(fields: [categoryId], references: [id])
  /// Legacy free-text cache of the category NAME, kept in sync with `category.name` on every write — @map points at the
  /// original "category" column so no migration/data-loss on this rename. Exists only for old code paths (CSV export,
  /// table filters, purchase-costing's MarkupRule lookup) that read a flat string; categoryId/category is the source of truth.
  categoryLabel String? @map("category")
  /// Legacy free-text label (e.g. "Tablet"). Superseded by `baseUnitId` —
  /// kept untouched for backward compat until the Phase 4 frontend migration;
  /// not read by any new packaging logic.
  unit         String
  /// Packaging system (configurable units) — every medicine has exactly one
  /// base stock unit; StockLedgerEntry/FEFO/valuation all operate in this
  /// unit. Required — Phase 2 backfill covers every pre-existing medicine.
  baseUnitId   String   @map("base_unit_id")
  baseUnit     Unit     @relation("MedicineBaseUnit", fields: [baseUnitId], references: [id])
  batchManaged Boolean  @default(true) @map("batch_managed")
  reorderLevel Decimal  @default(0) @map("reorder_level") @db.Decimal(14, 3)
  purchaseRate Decimal? @map("purchase_rate") @db.Decimal(14, 2)
  /// Per BASE unit — unchanged meaning, still what Dashboard/valuation/POS multiply against.
  saleRate     Decimal  @default(0) @map("sale_rate") @db.Decimal(14, 2)
  /// Percentage, e.g. 17 = 17%. pharmacy.md §19.2 flags this as entirely
  /// absent in hms-backend's pharmacy module — present from day one here.
  taxPercent   Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  isActive     Boolean  @default(true) @map("is_active")

  batches            MedicineBatch[]
  stockEntries       StockLedgerEntry[]
  purchaseLines      PurchaseLine[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       PharmacyInvoiceLine[]
  requestLines       MedicineRequestLine[]
  packagingLevels    MedicinePackagingLevel[]

  createdById   String?     @map("created_by")
  createdByUser PortalUser? @relation("MedicineCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("medicine_masters")
}

// ═══════════════════════════════════════════════════════════════════════
// Configurable Packaging / Units (medicine-packaging-plan — Phase 1 schema)
// Stock ledger always stays in BASE units; packaging is a conversion layer
// on top, with purchase/batch-level snapshots so later Medicine Master
// edits never corrupt historical purchases, batch quantities or costs.
// ═══════════════════════════════════════════════════════════════════════

/// Global reusable unit catalog (Box, Strip, Tablet, Vial, ...). Never
/// hard-deleted — historical batches/lines hold FK references.
model Unit {
  id          String   @id @default(uuid())
  name        String   @unique
  shortCode   String?  @map("short_code")
  /// Seeded standard units vs user-added custom units.
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  medicinesWithThisBaseUnit     MedicineMaster[]         @relation("MedicineBaseUnit")
  packagingLevels               MedicinePackagingLevel[]
  batchesWithThisPurchaseUnit   MedicineBatch[]          @relation("BatchPurchaseUnit")
  purchaseLinesWithThisUnit     PurchaseLine[]           @relation("PurchaseLineUnit")
  purchaseOrderLinesWithThisUnit PurchaseOrderLine[]     @relation("PurchaseOrderLineUnit")
  invoiceLinesWithThisUnit      PharmacyInvoiceLine[]    @relation("InvoiceLineSaleUnit")
  requestLinesWithThisUnit      MedicineRequestLine[]    @relation("RequestLineSaleUnit")

  @@map("units")
}

/// The packaging "template" per medicine — an ordered list of levels from
/// base (level 0, conversionToBase = 1) up to the largest pack. Each level
/// stores its FULL conversion to base units directly (not just to its
/// immediate parent) so POS/Purchase/Reports never need to walk the chain.
model MedicinePackagingLevel {
  id               String         @id @default(uuid())
  medicineId       String         @map("medicine_id")
  medicine         MedicineMaster @relation(fields: [medicineId], references: [id])
  unitId           String         @map("unit_id")
  unit             Unit           @relation(fields: [unitId], references: [id])
  level            Int
  conversionToBase Decimal        @map("conversion_to_base") @db.Decimal(14, 4)
  isPurchaseUnit   Boolean        @default(false) @map("is_purchase_unit")
  isSaleUnit       Boolean        @default(false) @map("is_sale_unit")
  /// Optional — e.g. a whole Box sold at a bulk discount instead of exactly
  /// conversionToBase x per-base saleRate.
  overrideSaleRate Decimal?       @map("override_sale_rate") @db.Decimal(14, 2)
  isActive         Boolean        @default(true) @map("is_active")

  @@unique([medicineId, level])
  @@map("medicine_packaging_levels")
}

/// FEFO enforced in the service layer (earliest expiryDate with stock wins) —
/// this table only stores batch identity; quantity is always derived from
/// StockLedgerEntry, never stored/edited directly (pharmacy.md §9 "Quantity Rule").
model MedicineBatch {
  id          String         @id @default(uuid())
  medicineId  String         @map("medicine_id")
  medicine    MedicineMaster @relation(fields: [medicineId], references: [id])
  batchNumber String         @map("batch_number")
  expiryDate  DateTime       @map("expiry_date") @db.Date
  /// Per BASE unit — unchanged meaning (derived from purchaseUnitConversionToBase when purchased in a larger pack).
  costRate    Decimal        @map("cost_rate") @db.Decimal(14, 2)
  saleRate    Decimal?       @map("sale_rate") @db.Decimal(14, 2)

  /// Packaging snapshot frozen at first purchase of this batch — later
  /// Medicine Master packaging edits must never retroactively change these
  /// (medicine-packaging-plan). Null for batches created before this feature
  /// (backfilled to conversionToBase=1, i.e. "purchased 1:1 in its base unit").
  purchaseUnitId               String?  @map("purchase_unit_id")
  purchaseUnit                 Unit?    @relation("BatchPurchaseUnit", fields: [purchaseUnitId], references: [id])
  purchaseUnitConversionToBase Decimal? @map("purchase_unit_conversion_to_base") @db.Decimal(14, 4)
  /// Full chain at purchase time, e.g. [{"unit":"Box","conversionToBase":100},{"unit":"Strip","conversionToBase":10},{"unit":"Tablet","conversionToBase":1}] — preserves intermediate levels for historical receipts even if Medicine Master's packaging later changes.
  packagingSnapshotJson        Json?    @map("packaging_snapshot_json")

  stockEntries  StockLedgerEntry[]
  purchaseLines PurchaseLine[]
  invoiceLines  PharmacyInvoiceLine[]
  requestLines  MedicineRequestLine[]

  createdById   String?     @map("created_by")
  createdByUser PortalUser? @relation("BatchCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@map("medicine_batches")
}

/// Append-only, delta-only (pharmacy.md §9.1) — all 8 movement types wired
/// from day one, not just RECEIPT/SALE/DISPENSE.
model StockLedgerEntry {
  id             String            @id @default(uuid())
  medicineId     String            @map("medicine_id")
  medicine       MedicineMaster    @relation(fields: [medicineId], references: [id])
  batchId        String?           @map("batch_id")
  batch          MedicineBatch?    @relation(fields: [batchId], references: [id])
  movementType   StockMovementType @map("movement_type")
  quantityDelta  Decimal           @map("quantity_delta") @db.Decimal(14, 3)
  referenceTable String            @map("reference_table")
  referenceId    String            @map("reference_id")
  note           String?
  actorId        String            @map("actor_id")
  actor          PortalUser        @relation("StockMovementActor", fields: [actorId], references: [id])
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([medicineId, batchId, createdAt])
  @@map("stock_ledger_entries")
}

model StockAdjustment {
  id               String         @id @default(uuid())
  /// System-generated (ADJ-0001…) — never manually typed, see DocumentSequence.
  adjustmentNumber String         @unique @map("adjustment_number")
  medicineId       String         @map("medicine_id")
  batchId      String?        @map("batch_id")
  type         AdjustmentType
  quantity     Decimal        @db.Decimal(14, 3)
  reason       String
  approvedById String?        @map("approved_by")
  createdById  String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("stock_adjustments")
}

// ═══════════════════════════════════════════════════════════════════════
// Vendors & Purchases (pharmacy.md §10 — entirely new, own model, never
// reuses hms-backend Inventory's Supplier/SupplierLedger — §19.3)
// ═══════════════════════════════════════════════════════════════════════

model Vendor {
  id               String  @id @default(uuid())
  /// System-generated (VND-0001…) — never manually typed, see DocumentSequence.
  code             String  @unique
  name             String
  contactPerson    String? @map("contact_person")
  phone            String?
  email            String?
  paymentTermsDays Int     @default(0) @map("payment_terms_days")
  isActive         Boolean @default(true) @map("is_active")

  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  ledgerEntries  VendorLedgerEntry[]

  createdById   String?     @map("created_by")
  createdByUser PortalUser? @relation("VendorCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("vendors")
}

/// pharmacy.md §10.3 formula: Opening + Purchases - Payments - Returns/Credits
/// +/- Adjustments = Closing. `amount` is the signed payable delta — positive
/// for PURCHASE_CREDIT (vendor owed more), negative for PAYMENT/RETURN_CREDIT.
model VendorLedgerEntry {
  id             String                @id @default(uuid())
  vendorId       String                @map("vendor_id")
  vendor         Vendor                @relation(fields: [vendorId], references: [id])
  entryType      VendorLedgerEntryType @map("entry_type")
  amount         Decimal               @db.Decimal(14, 2)
  /// System-generated business reference for the ONE entry that is the primary record of a standalone transaction — RET-0001… for a Purchase Return, VPAY-0001… for a standalone vendor payment. Null for entries that are just a side-effect of another document (e.g. the PURCHASE_CREDIT posted when a Purchase itself is created/posted — that transaction's reference is the Purchase's own purchaseNumber).
  referenceNo    String?               @unique @map("reference_no")
  description    String?
  referenceTable String?               @map("reference_table")
  referenceId    String?               @map("reference_id")
  actorId        String                @map("actor_id")
  actor          PortalUser            @relation("VendorLedgerActor", fields: [actorId], references: [id])
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_ledger_entries")
}

model Purchase {
  id              String         @id @default(uuid())
  /// System-generated (PO-0001…) — never manually typed, see DocumentSequence. Covers this record's whole lifecycle (Draft = PO stage, Posted = GRN stage); never renamed on posting.
  purchaseNumber  String         @unique @map("purchase_number")
  vendorId        String         @map("vendor_id")
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  purchaseDate    DateTime       @map("purchase_date") @db.Date
  vendorInvoiceNo String?        @map("vendor_invoice_no")
  paymentType     PaymentMethod? @map("payment_type")
  notes           String?
  status          PurchaseStatus @default(DRAFT)

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
  /// purchase-costing-plan — landed-cost component (freight/other charges), rolled into `total` and into each batch's effective cost-per-base-unit.
  freightTotal  Decimal @default(0) @map("freight_total") @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  paidNow       Decimal @default(0) @map("paid_now") @db.Decimal(14, 2)
  vendorDue     Decimal @default(0) @map("vendor_due") @db.Decimal(14, 2)

  lines PurchaseLine[]

  createdById   String     @map("created_by")
  createdByUser PortalUser @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("purchases")
}

model PurchaseLine {
  id             String         @id @default(uuid())
  purchaseId     String         @map("purchase_id")
  purchase       Purchase       @relation(fields: [purchaseId], references: [id])
  medicineId     String         @map("medicine_id")
  medicine       MedicineMaster @relation(fields: [medicineId], references: [id])
  batchId        String?        @map("batch_id")
  batch          MedicineBatch? @relation(fields: [batchId], references: [id])
  /// Always the BASE-unit total (= purchaseUnitQuantity x conversionToBaseSnapshot, server-derived). Unchanged meaning — still what posts to StockLedgerEntry.
  quantity       Decimal        @db.Decimal(14, 3)
  /// Per BASE unit — purchase-costing-plan: this is the LANDED cost (net of discount, +tax, +freight) divided by total base qty, never the raw vendor rate. Still what MedicineBatch.costRate derives from.
  unitCost       Decimal        @map("unit_cost") @db.Decimal(14, 2)
  /// purchase-costing-plan — how `discountAmount` below was entered; PERCENTAGE means discountAmount was computed from discountValue% x grossAmount at save time.
  discountType   DiscountType   @default(FLAT) @map("discount_type")
  /// Always the final FLAT PKR amount, regardless of discountType — unchanged meaning for totals math.
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  /// purchase-costing-plan — freight/other landed cost apportioned to this line, folded into unitCost (landed cost per base unit) and lineTotal.
  freightAmount  Decimal        @default(0) @map("freight_amount") @db.Decimal(14, 2)
  lineTotal      Decimal        @map("line_total") @db.Decimal(14, 2)

  /// What the user actually entered this line as (medicine-packaging-plan) — e.g. "5 Box" at "Rs 1200/Box". Null for pre-feature lines (backfilled to the medicine's base unit, qty = quantity, conversion = 1).
  purchaseUnitId           String?  @map("purchase_unit_id")
  purchaseUnit             Unit?    @relation("PurchaseLineUnit", fields: [purchaseUnitId], references: [id])
  purchaseUnitQuantity     Decimal? @map("purchase_unit_quantity") @db.Decimal(14, 3)
  conversionToBaseSnapshot Decimal? @map("conversion_to_base_snapshot") @db.Decimal(14, 4)
  /// True when this purchase used a one-off packaging conversion different from the medicine's current default (purchase-costing-plan "Override packaging for this purchase").
  packagingOverridden      Boolean  @default(false) @map("packaging_overridden")

  /// purchase-costing-plan selling-price suggestion — per BASE unit. `suggestedSaleRate` is the system's markup-rule recommendation (audit trail); `finalSaleRate` is what the Admin actually confirmed and is what gets written to MedicineBatch.saleRate / MedicineMaster.saleRate on post.
  suggestedSaleRate Decimal? @map("suggested_sale_rate") @db.Decimal(14, 2)
  finalSaleRate     Decimal? @map("final_sale_rate") @db.Decimal(14, 2)

  @@map("purchase_lines")
}

/// Purchase Order — the simple procurement reminder/order screen. Medicine +
/// required quantity/unit + vendor + notes/urgency, printable/WhatsApp-
/// shareable. Creating or editing one NEVER touches stock, batches, cost,
/// payment or the vendor ledger — those only happen when a real Purchase
/// (Stock In / GRN) is posted, optionally pre-filled from this PO via
/// "Receive / Convert to Stock In". A PO is never mandatory before a Purchase.
model PurchaseOrder {
  id           String              @id @default(uuid())
  /// System-generated (PREQ-0001…) — never manually typed, see DocumentSequence.
  orderNumber  String              @unique @map("order_number")
  vendorId     String              @map("vendor_id")
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  orderDate    DateTime            @map("order_date") @db.Date
  isUrgent     Boolean             @default(false) @map("is_urgent")
  notes        String?
  status       PurchaseOrderStatus @default(OPEN)

  lines PurchaseOrderLine[]

  createdById   String     @map("created_by")
  createdByUser PortalUser @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String         @id @default(uuid())
  purchaseOrderId String         @map("purchase_order_id")
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  medicineId      String         @map("medicine_id")
  medicine        MedicineMaster @relation(fields: [medicineId], references: [id])
  requiredUnitId  String         @map("required_unit_id")
  requiredUnit    Unit           @relation("PurchaseOrderLineUnit", fields: [requiredUnitId], references: [id])
  requiredQty     Decimal        @map("required_qty") @db.Decimal(14, 3)
  lineNotes       String?        @map("line_notes")

  @@map("purchase_order_lines")
}

// ═══════════════════════════════════════════════════════════════════════
// Sales / HMS Requests / Invoices (pharmacy.md §6/§7/§8 — real tax,
// discount, split payment and Outstanding/Clearance built in from day one,
// unlike hms-backend's pharmacy module which hardcodes full-cash-PAID — §19.2)
// ═══════════════════════════════════════════════════════════════════════

/// Inbound HMS medicine request, pre-invoice (pharmacy.md §7.1 steps 1-4).
/// `externalAdmissionRef`/`externalRequestRef` are plain strings, never a
/// cross-database FK — see the file header note on integration boundary.
model MedicineRequest {
  id                   String                @id @default(uuid())
  /// System-generated (REQ-0001…) — our INTERNAL processing reference, never manually typed. Distinct from externalRequestRef below.
  requestNumber        String                @unique @map("request_number")
  externalAdmissionRef String                @map("external_admission_ref")
  /// EXTERNAL — the HMS side's own reference, received as-is. Never replaced with an internally generated code.
  externalRequestRef   String?               @unique @map("external_request_ref")
  patientNameSnapshot  String?               @map("patient_name_snapshot")
  urgency              String?
  requestedByExternal  String?               @map("requested_by_external")
  status               MedicineRequestStatus @default(REQUESTED)
  rejectionReason      String?               @map("rejection_reason")
  /// pharmacy.md §7.3 — set only when a line/request crosses the configured
  /// high-value threshold; dispense is blocked until this is non-null.
  approvedById         String?               @map("approved_by")
  approvedByUser       PortalUser?           @relation("RequestApprovedBy", fields: [approvedById], references: [id])
  approvedAt           DateTime?             @map("approved_at")

  lines     MedicineRequestLine[]
  invoiceId String?               @map("invoice_id")
  invoice   PharmacyInvoice?      @relation(fields: [invoiceId], references: [id])

  handledById   String?     @map("handled_by")
  handledByUser PortalUser? @relation("RequestHandledBy", fields: [handledById], references: [id])
  requestedAt   DateTime    @default(now()) @map("requested_at")

  @@map("medicine_requests")
}

model MedicineRequestLine {
  id                String          @id @default(uuid())
  medicineRequestId String          @map("medicine_request_id")
  medicineRequest   MedicineRequest @relation(fields: [medicineRequestId], references: [id])
  medicineId        String          @map("medicine_id")
  medicine          MedicineMaster  @relation(fields: [medicineId], references: [id])
  batchId           String?         @map("batch_id")
  batch             MedicineBatch?  @relation(fields: [batchId], references: [id])
  /// Always BASE-unit quantities — unchanged meaning, still what FEFO/dispense uses.
  requestedQuantity Decimal         @map("requested_quantity") @db.Decimal(14, 3)
  dispensedQuantity Decimal         @default(0) @map("dispensed_quantity") @db.Decimal(14, 3)
  notes             String?
  

  /// What unit the request/dispense was actually expressed in (medicine-packaging-plan). Null = base unit (backward-compatible default).
  saleUnitId       String?  @map("sale_unit_id")
  saleUnit         Unit?    @relation("RequestLineSaleUnit", fields: [saleUnitId], references: [id])
  saleUnitQuantity Decimal? @map("sale_unit_quantity") @db.Decimal(14, 3)

  @@map("medicine_request_lines")
}

model PharmacyInvoice {
  processedCollectionReceipts String[] @default([]) @map("processed_collection_receipts")
  id                String           @id @default(uuid())
  /// System-generated — never manually typed, see DocumentSequence. INV-0001… for channel=RETAIL (POS Sale Invoice), PHI-0001… for channel=HMS_LINKED (Pharmacy Invoice) — two counters sharing this one column/table.
  invoiceNumber     String           @unique @map("invoice_number")
  channel                  SaleChannel
  externalAdmissionRef     String?                   @map("external_admission_ref")
  medicineRequestId        String?                   @map("medicine_request_id")
  medicineRequests         MedicineRequest[]
  customerName             String?                   @map("customer_name")

  subtotal        Decimal          @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal          @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal        Decimal          @default(0) @map("tax_total") @db.Decimal(14, 2)
  total           Decimal          @default(0) @db.Decimal(14, 2)
  paidTotal       Decimal          @default(0) @map("paid_total") @db.Decimal(14, 2)
  outstanding     Decimal          @default(0) @db.Decimal(14, 2)
  status          InvoiceStatus    @default(UNPAID)
  /// Only set for channel = HMS_LINKED (pharmacy.md §8).
  clearanceStatus ClearanceStatus? @map("clearance_status")

  collectionOwner          CollectionOwner           @default(PHARMACY_RETAIL) @map("collection_owner")
  hmsCollectedAmount       Decimal                   @default(0) @map("hms_collected_amount") @db.Decimal(14, 2)
  hmsSettledAmount         Decimal                   @default(0) @map("hms_settled_amount") @db.Decimal(14, 2)
  hmsReceivable            Decimal                   @default(0) @map("hms_receivable") @db.Decimal(14, 2)
  internalSettlementStatus InternalSettlementStatus? @map("internal_settlement_status")
  settlements              HmsReceivableSettlement[]

  lines    PharmacyInvoiceLine[]
  payments PharmacyPayment[]

  dispensedById   String     @map("dispensed_by")
  dispensedByUser PortalUser @relation("InvoiceDispensedBy", fields: [dispensedById], references: [id])
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([channel, externalAdmissionRef])
  @@map("pharmacy_invoices")
}

model PharmacyInvoiceLine {
  returnedQuantity Decimal @default(0) @map("returned_quantity") @db.Decimal(14, 3)
  returnedValue Decimal @default(0) @map("returned_value") @db.Decimal(14, 2)
  id             String          @id @default(uuid())
  invoiceId      String          @map("invoice_id")
  invoice        PharmacyInvoice @relation(fields: [invoiceId], references: [id])
  medicineId     String          @map("medicine_id")
  medicine       MedicineMaster  @relation(fields: [medicineId], references: [id])
  batchId        String?         @map("batch_id")
  batch          MedicineBatch?  @relation(fields: [batchId], references: [id])
  /// Always the BASE-unit quantity sold — unchanged meaning, still what FEFO allocation/stock deduction uses.
  quantity       Decimal         @db.Decimal(14, 3)
  rateSnapshot   Decimal         @map("rate_snapshot") @db.Decimal(14, 2)
  discountAmount Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineNet        Decimal         @map("line_net") @db.Decimal(14, 2)

  /// Traceability to specific medicine request, request line, and dispense event
  medicineRequestId  String?  @map("medicine_request_id")
  requestLineId      String?  @map("request_line_id")
  externalRequestRef String?  @map("external_request_ref")
  dispenseEventId    String?  @map("dispense_event_id")
  dispensedById      String?  @map("dispensed_by")
  dispensedAt        DateTime @default(now()) @map("dispensed_at")

  /// What the cashier actually sold this line as (medicine-packaging-plan) — e.g. "2 Strip". Null = base unit (backward-compatible default).
  saleUnitId       String?  @map("sale_unit_id")
  saleUnit         Unit?    @relation("InvoiceLineSaleUnit", fields: [saleUnitId], references: [id])
  saleUnitQuantity Decimal? @map("sale_unit_quantity") @db.Decimal(14, 3)

  @@index([invoiceId, dispenseEventId])
  @@map("pharmacy_invoice_lines")
}

/// One row per payment against an invoice — supports split and partial
/// payment (pharmacy.md §6.1/§8, entirely absent in hms-backend today).
model PharmacyPayment {
  id              String          @id @default(uuid())
  invoiceId       String          @map("invoice_id")
  invoice         PharmacyInvoice @relation(fields: [invoiceId], references: [id])
  amount          Decimal         @db.Decimal(14, 2)
  method          PaymentMethod
  reference       String?
  collectedById   String          @map("collected_by")
  collectedByUser PortalUser      @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  paidAt          DateTime        @default(now()) @map("paid_at")

  @@map("pharmacy_payments")
}

// ═══════════════════════════════════════════════════════════════════════
// Cash, Expenses, Settlement (pharmacy.md §11/§12 — own dedicated tables;
// no `moduleScope` discriminator needed since this DB is Pharmacy-only, so
// the hms-backend cash.service.ts moduleScope='BILLING' hardcode bug
// (pharmacy.md §19.3) cannot occur here structurally)
// ═══════════════════════════════════════════════════════════════════════

model CashLedgerEntry {
  id             String        @id @default(uuid())
  portalUserId   String        @map("portal_user_id")
  portalUser     PortalUser    @relation("CashEntryOwner", fields: [portalUserId], references: [id])
  direction      CashDirection
  amount         Decimal       @db.Decimal(14, 2)
  category       CashCategory
  /// System-generated business reference for the entry that is the primary record of a standalone transaction — PCA-0001… for Petty Cash issuance, RET-0001… for a Sales Return refund. Null for entries that are a side-effect of another document already carrying its own reference (purchase payment, POS sale collection, etc).
  referenceNo    String?       @unique @map("reference_no")
  isPhysicalCash Boolean       @default(true) @map("is_physical_cash")
  referenceTable String?       @map("reference_table")
  referenceId    String?       @map("reference_id")
  note           String?
  issuedById     String?       @map("issued_by")
  issuedByUser   PortalUser?   @relation("CashEntryIssuedBy", fields: [issuedById], references: [id])
  isSettled      Boolean       @default(false) @map("is_settled")
  occurredAt     DateTime      @default(now()) @map("occurred_at")

  @@index([portalUserId, occurredAt])
  @@map("cash_ledger_entries")
}

model AccountSettlement {
  id               String           @id @default(uuid())
  /// System-generated (SET-0001…) — never manually typed, see DocumentSequence.
  settlementNumber String           @unique @map("settlement_number")
  portalUserId     String           @map("portal_user_id")
  submittedByUser  PortalUser       @relation("SettlementSubmittedBy", fields: [portalUserId], references: [id])
  periodFrom       DateTime         @map("period_from") @db.Date
  periodTo         DateTime         @map("period_to") @db.Date
  expectedCash     Decimal          @map("expected_cash") @db.Decimal(14, 2)
  physicalCash     Decimal          @map("physical_cash") @db.Decimal(14, 2)
  variance         Decimal          @db.Decimal(14, 2)
  varianceReason   String?          @map("variance_reason")
  settlementAmount Decimal          @default(0) @map("settlement_amount") @db.Decimal(14, 2)
  status           SettlementStatus @default(SUBMITTED)
  submittedAt      DateTime         @default(now()) @map("submitted_at")
  reviewedById     String?          @map("reviewed_by")
  reviewedByUser   PortalUser?      @relation("SettlementReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?        @map("reviewed_at")

  @@map("account_settlements")
}

model HmsReceivableSettlement {
  id                    String                   @id @default(uuid())
  settlementNumber      String                   @unique @map("settlement_number")
  invoiceId             String                   @map("invoice_id")
  invoice               PharmacyInvoice          @relation(fields: [invoiceId], references: [id])
  externalAdmissionRef  String                   @map("external_admission_ref")
  patientNameSnapshot   String?                  @map("patient_name_snapshot")
  invoiceNumber         String                   @map("invoice_number")
  invoiceTotal          Decimal                  @db.Decimal(14, 2) @map("invoice_total")
  hmsCollected          Decimal                  @db.Decimal(14, 2) @map("hms_collected")
  amountRequested       Decimal                  @db.Decimal(14, 2) @map("amount_requested")
  amountReleased        Decimal                  @default(0) @db.Decimal(14, 2) @map("amount_released")
  remainingReceivable   Decimal                  @db.Decimal(14, 2) @map("remaining_receivable")
  status                InternalSettlementStatus @default(REQUESTED)

  requestedById         String                   @map("requested_by")
  requestedByUser       PortalUser               @relation("ReceivableSettlementRequestedBy", fields: [requestedById], references: [id])
  requestedAt           DateTime                 @default(now()) @map("requested_at")

  releasedAt            DateTime?                @map("released_at")
  paymentMethod         String?                  @map("payment_method")
  paymentReference      String?                  @map("payment_reference")
  releaseRemarks        String?                  @map("release_remarks")

  @@map("hms_receivable_settlements")
}

model Expense {
  id            String        @id @default(uuid())
  /// System-generated (EXP-0001…) — never manually typed, see DocumentSequence.
  expenseNumber String        @unique @map("expense_number")
  category      String
  date          DateTime      @db.Date
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @map("payment_method")
  payeeOrVendor String?       @map("payee_or_vendor")
  description   String
  /// EXTERNAL reference — the payee's own receipt/bill/cheque number. Manually entered by design; never system-generated. Distinct from `expenseNumber` above.
  referenceNo   String?       @map("reference_no")
  attachmentUrl String?       @map("attachment_url")

  enteredById    String      @map("entered_by")
  enteredByUser  PortalUser  @relation("ExpenseEnteredBy", fields: [enteredById], references: [id])
  approvedById   String?     @map("approved_by")
  approvedByUser PortalUser? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?   @map("approved_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("expenses")
}

/// Singleton — pharmacy.md §3 Settings screen / §7.3 "Configured by
/// Management/Super Admin settings; not hardcoded." One row, always upserted.
model PharmacySettings {
  id                       String   @id @default(uuid())
  highValueApprovalEnabled Boolean  @default(false) @map("high_value_approval_enabled")
  /// PKR — request/invoice total at or above this needs approval before dispense.
  highValueThreshold       Decimal  @default(0) @map("high_value_threshold") @db.Decimal(14, 2)
  /// Pre-filled as the tax rate for newly created medicines when not specified (pharmacy.md §3 "Tax/discount" policy).
  defaultTaxPercent        Decimal  @default(0) @map("default_tax_percent") @db.Decimal(5, 2)
  /// 0 = no cap. POS line/invoice discount percent above this is rejected.
  maxDiscountPercent       Decimal  @default(0) @map("max_discount_percent") @db.Decimal(5, 2)
  /// Replaces the hardcoded 90-day window for "Near Expiry" everywhere it is computed.
  nearExpiryWindowDays     Int      @default(90) @map("near_expiry_window_days")
  receiptHeaderText        String?  @map("receipt_header_text")
  receiptFooterText        String?  @map("receipt_footer_text")
  hospitalName             String?  @map("hospital_name")
  pharmacySubtitle         String?  @map("pharmacy_subtitle")
  address                  String?  @map("address")
  phone                    String?  @map("phone")
  email                    String?  @map("email")
  footerTerms              String?  @map("footer_terms")
  footerMessage            String?  @map("footer_message")
  footerPoweredBy          String?  @map("footer_powered_by")
  /// purchase-costing-plan — global fallback markup when a medicine's category has no MarkupRule row. Suggested Sale Price = Effective Cost/Base Unit x (1 + this/100).
  defaultMarkupPercent     Decimal  @default(20) @map("default_markup_percent") @db.Decimal(6, 2)
  updatedAt                DateTime @updatedAt @map("updated_at")
  updatedById              String?  @map("updated_by")

  @@map("pharmacy_settings")
}

/// purchase-costing-plan — category-wise markup override (e.g. Injection=15%, Syrup=18%).
/// A medicine whose category has no row here falls back to PharmacySettings.defaultMarkupPercent.
model MarkupRule {
  id            String   @id @default(uuid())
  category      String   @unique
  markupPercent Decimal  @map("markup_percent") @db.Decimal(6, 2)
  isActive      Boolean  @default(true) @map("is_active")
  updatedById   String?  @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("markup_rules")
}

/// Database-driven Therapeutic Category master (Settings -> Medicine Categories). Deactivate, never delete —
/// a medicine whose category is later deactivated keeps its categoryId/relation untouched and still displays
/// correctly; the dropdown on Add/Edit Medicine just stops OFFERING an inactive category for NEW selections.
model MedicineCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  medicines     MedicineMaster[]
  createdById   String?     @map("created_by")
  createdByUser PortalUser? @relation("MedicineCategoryCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("medicine_categories")
}

/// System-generated-identifiers audit — one monotonically-increasing counter
/// per business-code prefix (vendor/medicine/purchase/invoice/…). Incremented
/// via an atomic `INSERT … ON CONFLICT DO UPDATE … RETURNING` inside the same
/// transaction as the record it numbers, so Postgres's row lock makes
/// concurrent creates serialize safely — no two callers can ever receive the
/// same number, and a rolled-back transaction un-reserves its number instead
/// of leaving a gap-free guarantee it can't keep. Never decremented, so a
/// cancelled/deleted record's code is never handed out again.
model DocumentSequence {
  key       String   @id
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("document_sequences")
}
