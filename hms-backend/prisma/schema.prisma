// ═══════════════════════════════════════════════════════════════════════
// CH Sharif and Saeed Hospital — HMS Backend — Prisma schema
//
// Modeled directly from PROJECT_MASTER_SPEC.md §6 (PostgreSQL Database
// Design), which is itself derived from `16 Client.pdf` (Source of Truth
// v6.3). Domain letters (A–H) below match §6.3's domain groupings.
// Model/table names follow the naming this phase was scoped to; where a
// spec table was split, merged, or renamed for this phase, a comment notes
// the corresponding §6 table(s) it replaces.
//
// Conventions (§6.1, §6.13):
//   - id: UUID, default(uuid())
//   - money: Decimal(14,2)   |   quantity: Decimal(14,3)
//   - snake_case columns via @map, camelCase in Prisma Client
//   - master/config tables: isActive soft-delete flag, never hard-deleted
//   - transactional/ledger tables: append-only, no delete of any kind —
//     corrections are new adjustment/reversal rows, never in-place edits
//   - every mutable/transactional row carries actor attribution
//     (createdBy / approvedBy / collectedBy / ... → portal_users), per the
//     "Universal Audit Trail" principle (D16 p.22)
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────────────
// Enums (§6.2)
// ───────────────────────────────────────────────────────────────────────

